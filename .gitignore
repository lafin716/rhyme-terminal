# Local CI validation tools and collected build output
.scratch/ci-cd/
artifacts/

# Throwaway sandboxes the QA scripts create next to their reports:
# headless Chrome user-data dirs and native-run HOME/config trees.
.scratch/**/chrome-*/
.scratch/**/native-*/

# Binaries and databases a QA run copies aside to reproduce a fix. The
# scripts and reports next to them are worth keeping; a 200 MB pdb is not.
.scratch/**/*.exe
.scratch/**/*.pdb
.scratch/**/*.dll
.scratch/**/*.d
.scratch/**/*.sqlite3
.scratch/**/*.sqlite3-shm
.scratch/**/*.sqlite3-wal

dist-android/
