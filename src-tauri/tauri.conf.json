{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhyme-terminal",
  "version": "0.3.2",
  "identifier": "com.user.winmux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rhyme-terminal",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFN0RCMDMzMTc0ODIwRDIKUldUU0lFZ1hNN0I5YnJlaWtKc2laZEgrT0l4Z2E5cjBxaFQrcWE0MmtTNkJpTklRL2JlN3lNR1EK",
      "endpoints": [
        "https://github.com/lafin716/rhyme-terminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
