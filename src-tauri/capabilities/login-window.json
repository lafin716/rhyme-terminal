{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "login-window",
  "description": "Capability for the floating OAuth login window (see src/lib/floating-login.ts)",
  "windows": ["oauth-login"],
  "webviews": ["oauth-login"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus"
  ]
}
