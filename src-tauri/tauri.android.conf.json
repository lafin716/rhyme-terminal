{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build:android",
    "frontendDist": "../dist-android"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rhyme Terminal",
        "url": "native-mobile.html",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'self'"
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 24
    }
  }
}
