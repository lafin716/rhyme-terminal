        let mut p = state.pairings.lock();
        let d = p
            .devices
            .get_mut(&token)
            .ok_or("기기 인증에 실패했습니다. PC에서 다시 페어링하세요.")?;
        if d.connections >= 4 {
            return Err("이 기기의 동시 연결 수를 초과했습니다.".into());
        }
