    let (token, id, mut cancel, _registration) = match auth {
        Ok(value) => value,
        Err(message) => {
            let _ = send(&mut socket, json!({"type":"error","message":message})).await;
            return;
        }
    };
    if *cancel.borrow() {
        return;
    }
    let work = async {
        send(
            &mut socket,
            json!({"type":"authenticated","token":token,"deviceId":id}),
